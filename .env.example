# Base URL of the Laravel API as seen by the browser, including /api.
# Keep "/api" in development: Vite proxies it to VITE_BACKEND_URL.
# Production build: VITE_API_BASE_URL=https://api-bank.rumput.tech/api
# (pass it on the command line or put it in a git-ignored .env.production.local).
VITE_API_BASE_URL=/api

# Dev server only: where the Vite proxy forwards /api (not exposed to the browser).
VITE_BACKEND_URL=http://localhost:8000

# Build only: the path the app is served under. Default /api/ (https://bank.rumput.tech/api/).
# VITE_BASE_PATH=/
